# Required: Your Trilium ETAPI token
# Get it from Trilium: Options → ETAPI → Create new ETAPI token
TRILIUM_TOKEN=your-token-here

# Optional: Trilium URL (only needed for Docker or custom setups)
# Default: http://localhost:37840
# TRILIUM_URL=http://localhost:37840

# Optional: Folder that contentFilePath may read from
# contentFilePath is disabled if this is not set
# TRILIUM_CONTENT_DIR=/absolute/path/to/folder
